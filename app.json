
{
  "expo": {
    "name": "Advocate Dashboard",
    "slug": "EfilingApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/advocate-icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#071A3D",
        "foregroundImage": "./assets/advocate-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vijay15july.EfilingApp"
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adv_dash.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#071A3D"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-asset"
    ],

    "extra": {
      "eas": {
        "projectId": "f32238ea-ee41-4f56-a599-f2584be7bc68"
      }
    },

    "owner": "vijayahc"
  }
}
